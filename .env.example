# Copy to .env and fill in real values. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true
PUBLIC_HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-generate-a-strong-random-value
POSTGRES_DB=electronics_shop

# --- JWT / CSRF ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-a-64-char-hex-secret
CSRF_SECRET_KEY=change-me-generate-a-64-char-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated origins, no wildcards) ---
CORS_ALLOW_ORIGINS=http://localhost

# --- Google OAuth2 / OIDC (leave blank to keep Google login disabled) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/v1/auth/google/callback

# --- ZarinPal Sandbox (leave blank to keep payments disabled) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost/api/v1/payments/callback

# --- Misc ---
OPENAPI_ENABLED=true

# --- Seed data (Phase 11) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-generate-a-strong-random-value
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=change-me-generate-a-strong-random-value
